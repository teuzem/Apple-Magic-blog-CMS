# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-04
NEXT_PUBLIC_SANITY_PROJECT_TITLE=Apple Magic Blog
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=

# Canonical public origin used by metadata, hreflang, JSON-LD and sitemaps.
NEXT_PUBLIC_SITE_URL=https://applemagic.blog
NEXT_PUBLIC_URL=https://applemagic.blog

# Optional stock-image providers for the Sanity Studio image picker.
# Keep these server-side: do not prefix them with NEXT_PUBLIC_.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Self-hosted Node.js runtime. Most managed providers set PORT automatically.
HOSTNAME=0.0.0.0
PORT=3000
